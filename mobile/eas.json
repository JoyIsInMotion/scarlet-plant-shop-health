{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "node": "24.15.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://scarletflowers.netlify.app",
        "NPM_CONFIG_IGNORE_SCRIPTS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "24.15.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://scarletflowers.netlify.app",
        "NPM_CONFIG_IGNORE_SCRIPTS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
