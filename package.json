{
  "name": "scarlet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names \"web,mobile\" --prefix-colors \"blue,green\" \"npm run dev --workspace=apps/web\" \"npm run start --workspace=apps/mobile\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "db:generate": "npm run db:generate --workspace=apps/web",
    "db:migrate": "npm run db:migrate --workspace=apps/web",
    "db:seed": "npm run db:seed --workspace=apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "expo-router": "~56.2.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "expo-dev-client": "~56.0.15"
  }
}
