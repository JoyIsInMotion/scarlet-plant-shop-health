# Database (Neon serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/scarlet?sslmode=require

# JWT
JWT_ACCESS_SECRET=your-64-char-hex-access-secret
JWT_REFRESH_SECRET=your-64-char-hex-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=scarlet-media
R2_PUBLIC_URL=https://pub-yourhash.r2.dev

# Groq AI API (free tier — get key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Pexels API (product photos — free at https://www.pexels.com/api/)
PEXELS_API_KEY=your-pexels-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS — optional comma-separated allowlist of origins permitted to call /api/*.
# Leave unset to allow any origin ("*"), which is safe because the API is
# Bearer-authed and never relies on cross-origin cookies. Set this to lock the
# API down to known web/mobile origins, e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.scarlet.com,http://localhost:8081
# CORS_ALLOWED_ORIGINS=

# Node environment
NODE_ENV=development
